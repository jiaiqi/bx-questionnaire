# 测试环境配置
#
# 运行时已刻意移除网关兜底默认值（缺失即报错，避免生产静默连到内网），
# 所以测试必须显式提供网关。
#
# VITE_BX_TICKET 不在这里配置：vitest 会同时加载 .env.local，
# 联调票据从那里读取（该文件在 .gitignore 中），集成测试据此决定是否跳过。

VITE_BX_GATEWAY=http://192.168.0.214/bxapi
VITE_BX_APP=daq
VITE_BX_APP_NO=APPNO20250709152308
VITE_BX_TIMEOUT=20000
# 与生产一致：测试环境部署在站点根目录的 /quest/ 下（server.js 在根目录 /js/）
VITE_H5_BASE=/quest/
