# 环境变量模板：复制为 .env.local 后填入本地值（.env.local 不会入库）
#
# 必填
VITE_BX_GATEWAY=http://192.168.0.214/bxapi
VITE_BX_APP=daq
VITE_BX_APP_NO=APPNO20250709152308
#
# 本地联调票据：**只放 .env.local**，禁止提交。
#
# ⚠️ 不要把这一行连同空值复制进 .env.development / .env.test：
# Vite 的 .env.[mode] 优先级高于 .env.local，空值会把 .env.local 里的
# 真实票据覆盖掉，开发环境所有请求都不带 bx_auth_ticket，且**不报错** ——
# 按 activity_no 查询的接口匿名也有数据，问题极难发现。
VITE_BX_TICKET=
#
# 可选
VITE_BX_TIMEOUT=20000
VITE_BX_WX_APPID=wx78d1d4139f97ffca
VITE_BX_WX_MP_APPID=wxa8574a1e93d8e8d0
VITE_H5_BASE=/
